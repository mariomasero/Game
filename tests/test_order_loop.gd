extends "res://tests/test_laboratory_3d.gd"

# Real scene/input checks: disconnected buttons, inaccessible machine, or a clock
# that runs during pause must fail here, even if domain-only tests pass.
func _run() -> void:
	var scene: PackedScene = load("res://scenes/world/laboratory_3d.tscn")
	var lab: Node3D = scene.instantiate()
	lab.get_node("Persistence").enabled = false
	root.add_child(lab)
	await _frames(5)
	_check(lab.has_node("Session"), "La sala contiene una sesión jugable de pedidos")
	if not lab.has_node("Session"):
		lab.queue_free()
		await process_frame
		quit(1)
		return
	var session: Node = lab.get_node("Session")
	var player: CharacterBody3D = lab.get_node("Player")
	var hud: CanvasLayer = lab.get_node("HUD")
	var panel: Control = hud.get_node("Overlay")
	var content: VBoxContainer = panel.get_node("Panel/Margin/Content")
	player.position = Vector3(-1.8, 0, 0.5)
	await _frames(5)
	await _action(&"interact")
	_check(panel.visible, "E abre las compras y el encargo en el ordenador")
	for purchase in range(10):
		await _click(content.get_node("Actions/BuyMatrix"))
	_check(session.money == 0 and session.count_item(&"matrix") == 10, "Se puede invertir todo el saldo en existencias")
	await _click(content.get_node("Actions/Refund"))
	_check(session.money == 120 and session.count_item(&"matrix") == 0, "Devolver insumos permite recuperar una compra mal repartida")
	await _click(content.get_node("Actions/BuyMatrix"))
	await _click(content.get_node("Actions/BuyCatalyst"))
	_check(session.money == 100, "Comprar ambos insumos desde botones descuenta 20 créditos")
	_check(session.count_item(&"matrix") == 1 and session.count_item(&"catalyst") == 1, "Las compras llegan al inventario")
	await _click(content.get_node("Actions/Deliver"))
	_check(session.money == 100 and session.completed_orders == 0, "Entregar sin producto no paga")
	_check(not content.get_node("Feedback").text.is_empty(), "La operación rechazada explica el motivo")
	await _action(&"ui_cancel")
	player.position = Vector3(2.6, 0, -2.45)
	await _frames(5)
	await _action(&"interact")
	_check(panel.visible and content.get_node("Actions/Start").visible, "La máquina abre su preparación de lotes")
	await _click(content.get_node("Actions/Start"))
	_check(session.batch_state == &"producing", "El botón de máquina inicia producción")
	_check(session.count_item(&"matrix") == 0 and session.count_item(&"catalyst") == 0, "Iniciar consume los dos insumos una sola vez")
	await _click(content.get_node("Actions/Collect"))
	_check(session.count_item(&"lumen") == 0, "Recoger anticipadamente no crea producto")
	await _action(&"ui_cancel")
	var before_move: Vector3 = player.position
	var before_time: float = session.remaining_seconds
	await _walk([&"move_down"], 15)
	_check(player.position.distance_to(before_move) > 0.4, "Se puede caminar mientras produce la máquina")
	_check(session.remaining_seconds < before_time, "La producción avanza fuera del panel")
	await _action(&"ui_cancel")
	_check(paused and hud.get_node("PauseOverlay").visible, "Escape desde la sala abre pausa")
	var paused_time: float = session.remaining_seconds
	var paused_position: Vector3 = player.position
	Input.action_press(&"move_down")
	await create_timer(0.15, true).timeout
	Input.action_release(&"move_down")
	_check(session.remaining_seconds == paused_time, "La pausa detiene el tiempo del lote")
	_check(player.position == paused_position, "La pausa detiene también el movimiento")
	await _action(&"ui_cancel")
	_check(not paused, "Escape reanuda la sesión")
	# Wait for the actual 12-second runtime, without fast-forwarding domain state.
	var ready: bool = await _await_until(func() -> bool: return session.batch_state == &"ready", 900)
	_check(ready, "El reloj real completa el lote")
	player.position = Vector3(2.6, 0, -2.45)
	await _frames(5)
	await _action(&"interact")
	await _click(content.get_node("Actions/Collect"))
	_check(session.count_item(&"lumen") == 1 and session.batch_state == &"empty", "Recoger transfiere la muestra al inventario")
	await _click(content.get_node("Actions/Collect"))
	_check(session.count_item(&"lumen") == 1, "Repetir recogida no duplica la muestra")
	await _action(&"ui_cancel")
	player.position = Vector3(-1.8, 0, 0.5)
	await _frames(5)
	await _action(&"interact")
	await _click(content.get_node("Actions/Deliver"))
	_check(session.money == 135 and session.completed_orders == 1, "Entregar desde el ordenador paga 35 créditos")
	_check(not content.get_node("Actions/Deliver").visible, "La entrega completada deja de estar disponible")
	await _click(content.get_node("Actions/Request"))
	_check(session.order_active and session.order_id == 2, "Solicitar otra orden permite repetir el ciclo")
	await _action(&"ui_cancel")
	# Wall placed between accessible front and player must block machine access.
	player.position = Vector3(2.6, 0, -2.2)
	var wall := StaticBody3D.new()
	var collider := CollisionShape3D.new()
	var shape := BoxShape3D.new()
	shape.size = Vector3(2, 2, 0.1)
	collider.shape = shape
	wall.add_child(collider)
	lab.add_child(wall)
	wall.position = Vector3(2.6, 0.8, -2.7)
	await _frames(5)
	await _action(&"interact")
	_check(not panel.visible, "Una pared impide usar la máquina")
	wall.queue_free()
	await _frames(5)
	await _action(&"interact")
	_check(panel.visible, "Quitar la pared recupera el acceso a la máquina")
	await _action(&"ui_cancel")
	_check(player.controls_enabled, "Cerrar devuelve el control del personaje")
	lab.queue_free()
	await process_frame
	print("RESULTADO PEDIDOS: %d comprobaciones, %d fallos" % [checks, failures])
	quit(1 if failures else 0)
